<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>LinkLauncher.App</RootNamespace>
    <AssemblyName>LinkLauncher</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Description>Launcher Roblox indépendant pour Windows.</Description>
    <SatelliteResourceLanguages>fr;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LinkLauncher.Core\LinkLauncher.Core.csproj" />
    <ProjectReference Include="..\LinkLauncher.Infrastructure\LinkLauncher.Infrastructure.csproj" />
    <ProjectReference Include="..\LinkLauncher.Features\LinkLauncher.Features.csproj" />
  </ItemGroup>

</Project>
