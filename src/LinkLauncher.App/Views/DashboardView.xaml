<UserControl x:Class="LinkLauncher.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Focusable="False">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False">
        <StackPanel Margin="{StaticResource Padding.Page}" MaxWidth="1180" HorizontalAlignment="Stretch">

            <!-- En-tête -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Style="{StaticResource Text.PageTitle}" Text="Dashboard" />
                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource Text.Body.Secondary}"
                               Text="État du client Roblox officiel installé sur ce PC." />
                </StackPanel>

                <Button Grid.Column="1"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="Actualiser"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource Button.Secondary}"
                        ToolTip="Relancer la détection de l'installation Roblox">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="12" Style="{StaticResource Text.Icon}" Text="&#xE72C;" />
                        <TextBlock Margin="8,0,0,0" Text="Actualiser" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Erreur -->
            <Border Margin="0,0,0,14"
                    Padding="14,10"
                    Background="{DynamicResource Brush.Danger.Subtle}"
                    BorderBrush="{DynamicResource Brush.Danger}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Control}"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="13" Foreground="{DynamicResource Brush.Danger}" Style="{StaticResource Text.Icon}" Text="&#xEA39;" />
                    <TextBlock Margin="10,0,0,0"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               Style="{StaticResource Text.Body.Secondary}"
                               Text="{Binding ErrorMessage}" />
                </StackPanel>
            </Border>

            <!-- Carte principale -->
            <Border Style="{StaticResource Card.Hero}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Width="56"
                                Height="56"
                                VerticalAlignment="Top"
                                Background="{DynamicResource Brush.Accent.Subtle}"
                                BorderBrush="{DynamicResource Brush.Accent.Border}"
                                BorderThickness="1"
                                CornerRadius="16">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="24"
                                       Foreground="{DynamicResource Brush.Accent}"
                                       Style="{StaticResource Text.Icon}"
                                       Text="&#xE768;" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource Brush.Text.Tertiary}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusKind}" Value="Ready">
                                                    <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusKind}" Value="Warning">
                                                    <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusKind}" Value="Error">
                                                    <Setter Property="Fill" Value="{DynamicResource Brush.Danger}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Margin="10,0,0,0"
                                           Style="{StaticResource Text.Headline}"
                                           Text="{Binding StatusHeadline}" />
                            </StackPanel>

                            <TextBlock Margin="0,8,0,0"
                                       Style="{StaticResource Text.Body.Secondary}"
                                       Text="{Binding StatusDescription}" />

                            <TextBlock Margin="0,10,0,0"
                                       Style="{StaticResource Text.Caption}"
                                       Text="{Binding LastCheckedText}" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource Divider}" />

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Button AutomationProperties.Name="Jouer"
                                    Command="{Binding PlayCommand}"
                                    Style="{StaticResource Button.Primary}"
                                    ToolTip="Lancer le client Roblox officiel">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="12" Style="{StaticResource Text.Icon}" Text="&#xE768;" />
                                    <TextBlock Margin="8,0,0,0" Text="Jouer" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Margin="10,0,0,0"
                                    AutomationProperties.Name="Ouvrir le dossier Roblox"
                                    Command="{Binding OpenInstallationFolderCommand}"
                                    Style="{StaticResource Button.Secondary}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="13" Style="{StaticResource Text.Icon}" Text="&#xE838;" />
                                    <TextBlock Margin="8,0,0,0" Text="Ouvrir le dossier Roblox" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Margin="6,0,0,0"
                                    Command="{Binding OpenSettingsCommand}"
                                    Content="Paramètres"
                                    Style="{StaticResource Button.Subtle}" />
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Margin="16,0,0,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource Text.Caption}"
                                   Text="Le client officiel est démarré sans session. Pour rejoindre une expérience, utilisez le site Roblox : votre navigateur y gère lui-même votre connexion." />
                    </Grid>
                </Grid>
            </Border>

            <!-- Avertissement -->
            <Border Margin="0,14,0,0"
                    Padding="14,10"
                    Background="{DynamicResource Brush.Warning.Subtle}"
                    BorderBrush="{DynamicResource Brush.Warning}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Control}"
                    Visibility="{Binding WarningMessage, Converter={StaticResource NullToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="13" Foreground="{DynamicResource Brush.Warning}" Style="{StaticResource Text.Icon}" Text="&#xE7BA;" />
                    <TextBlock Margin="10,0,0,0"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               Style="{StaticResource Text.Body.Secondary}"
                               Text="{Binding WarningMessage}" />
                </StackPanel>
            </Border>

            <!-- Informations -->
            <WrapPanel Margin="0,16,-12,0">
                <Border MinWidth="228" Margin="{StaticResource Spacing.CardGap}" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Caption}" Text="Version du client" />
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Value}" Text="{Binding RobloxVersion}" />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource Text.Caption}"
                                   Text="Déclarée par RobloxPlayerBeta.exe" />
                    </StackPanel>
                </Border>

                <Border MinWidth="228" Margin="{StaticResource Spacing.CardGap}" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Caption}" Text="Dossier de version" />
                        <TextBlock Margin="0,8,0,0"
                                   FontSize="13"
                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                   Style="{StaticResource Text.Mono}"
                                   Text="{Binding VersionFolderName}" />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource Text.Caption}"
                                   Text="Dossier lu dans %LOCALAPPDATA%\Roblox\Versions" />
                    </StackPanel>
                </Border>

                <Border MinWidth="228" Margin="{StaticResource Spacing.CardGap}" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Caption}" Text="LinkLauncher" />
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Value}" Text="{Binding LauncherVersion}" />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource Text.Caption}"
                                   Text="Phase 2 — lancement officiel" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Installation -->
            <Border Margin="0,4,0,0" Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Text.Section}" Text="Installation" />
                        <Border Margin="10,1,0,0"
                                Padding="9,2"
                                VerticalAlignment="Center"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Pill}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Success.Subtle}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInstallationComplete}" Value="False">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Warning.Subtle}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Style="{StaticResource Text.Caption}"
                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                       Text="{Binding IntegrityBadgeText}" />
                        </Border>
                    </StackPanel>

                    <Border Margin="0,12,0,0" Style="{StaticResource Card.Inset}">
                        <TextBlock Style="{StaticResource Text.Mono}" Text="{Binding InstallationPath}" />
                    </Border>

                    <TextBlock Margin="0,10,0,0"
                               Style="{StaticResource Text.Body.Secondary}"
                               Text="{Binding IntegritySummary}" />

                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource Text.Caption}"
                               Text="{Binding RecommendedMissingText}"
                               Visibility="{Binding RecommendedMissingText, Converter={StaticResource NullToVisibility}}" />

                    <Button Margin="0,14,0,0"
                            HorizontalAlignment="Left"
                            Command="{Binding OpenDownloadPageCommand}"
                            Content="Installer ou réparer (site officiel)"
                            Style="{StaticResource Button.Secondary}" />

                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource Text.Caption}"
                               Text="Ouvre la page officielle roblox.com/download dans votre navigateur. LinkLauncher ne lance aucune installation silencieuse et ne modifie aucun fichier Roblox." />
                </StackPanel>
            </Border>

            <!-- Client Roblox -->
            <Border Margin="0,14,0,0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Section}" Text="Client Roblox" />

                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource Brush.Text.Tertiary}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LaunchStateText}" Value="Roblox est ouvert">
                                            <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Margin="10,0,0,0"
                                   Style="{StaticResource Text.Strong}"
                                   Text="{Binding LaunchStateText}" />
                    </StackPanel>

                    <TextBlock Margin="0,6,0,0"
                               Style="{StaticResource Text.Body.Secondary}"
                               Text="{Binding ProcessDetails}" />

                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource Text.Caption}"
                               Text="Le suivi se limite à la présence du processus et au code de sortie rapporté par Windows. Aucune mémoire, aucun module et aucun fil du client ne sont examinés ou modifiés." />
                </StackPanel>
            </Border>

            <!-- Apparence -->
            <Border Margin="0,14,0,0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Section}" Text="Apparence" />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource Text.Body.Secondary}"
                                   Text="Thème clair ou sombre et couleur d'accentuation, enregistrés automatiquement." />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Command="{Binding OpenSettingsCommand}"
                            Content="Ouvrir les paramètres"
                            Style="{StaticResource Button.Secondary}" />
                </Grid>
            </Border>

            <TextBlock Margin="0,14,0,0"
                       Style="{StaticResource Text.Caption}"
                       Text="Vérification en cours…"
                       Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}" />

            <TextBlock Margin="0,14,0,0"
                       Style="{StaticResource Text.Caption}"
                       Text="Demande de lancement en cours…"
                       Visibility="{Binding IsLaunching, Converter={StaticResource BooleanToVisibility}}" />
        </StackPanel>
    </ScrollViewer>

</UserControl>
