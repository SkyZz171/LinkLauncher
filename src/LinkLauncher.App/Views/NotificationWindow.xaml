<Window x:Class="LinkLauncher.App.Views.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LinkLauncher"
        Width="360"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Focusable="False"
        Opacity="0"
        WindowStartupLocation="Manual">

    <Border Margin="12"
            Padding="16"
            Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Stroke.Strong}"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius.Card}"
            MouseLeftButtonUp="OnDismiss">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Width="34"
                    Height="34"
                    VerticalAlignment="Top"
                    Background="{DynamicResource Brush.Accent.Subtle}"
                    BorderBrush="{DynamicResource Brush.Accent.Border}"
                    BorderThickness="1"
                    CornerRadius="10">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Foreground="{DynamicResource Brush.Accent}"
                           Style="{StaticResource Text.Icon}"
                           Text="&#xE768;" />
            </Border>

            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <TextBlock Style="{StaticResource Text.Strong}" Text="{Binding Title}" />
                <TextBlock Margin="0,3,0,0"
                           Style="{StaticResource Text.Body.Secondary}"
                           Text="{Binding Body}" />
                <TextBlock Margin="0,8,0,0"
                           Style="{StaticResource Text.Caption}"
                           Text="Cliquez pour fermer." />
            </StackPanel>
        </Grid>
    </Border>

</Window>
