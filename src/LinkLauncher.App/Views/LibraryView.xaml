<UserControl x:Class="LinkLauncher.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Focusable="False">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False">
        <StackPanel Margin="{StaticResource Padding.Page}" MaxWidth="1180" HorizontalAlignment="Stretch">

            <!-- En-tête -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Style="{StaticResource Text.PageTitle}" Text="Bibliothèque" />
                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource Text.Body.Secondary}"
                               Text="Vos expériences Roblox et le profil de lancement appliqué au client officiel." />
                </StackPanel>

                <Border Grid.Column="1"
                        Padding="12,5"
                        VerticalAlignment="Top"
                        Background="{DynamicResource Brush.Accent.Subtle}"
                        BorderBrush="{DynamicResource Brush.Accent.Border}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Pill}">
                    <TextBlock Style="{StaticResource Text.Caption}"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               Text="{Binding ActiveProfileSummary}" />
                </Border>
            </Grid>

            <!-- Erreur -->
            <Border Margin="0,0,0,14"
                    Padding="14,10"
                    Background="{DynamicResource Brush.Danger.Subtle}"
                    BorderBrush="{DynamicResource Brush.Danger}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Control}"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="13" Foreground="{DynamicResource Brush.Danger}" Style="{StaticResource Text.Icon}" Text="&#xEA39;" />
                    <TextBlock Margin="10,0,0,0"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               Style="{StaticResource Text.Body.Secondary}"
                               Text="{Binding ErrorMessage}" />
                </StackPanel>
            </Border>

            <!-- Confirmation -->
            <Border Margin="0,0,0,14"
                    Padding="14,10"
                    Background="{DynamicResource Brush.Success.Subtle}"
                    BorderBrush="{DynamicResource Brush.Success}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Control}"
                    Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="13" Foreground="{DynamicResource Brush.Success}" Style="{StaticResource Text.Icon}" Text="&#xE73E;" />
                    <TextBlock Margin="10,0,0,0"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               Style="{StaticResource Text.Body.Secondary}"
                               Text="{Binding StatusMessage}" />
                </StackPanel>
            </Border>

            <!-- 1. Ajouter une expérience -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Section}" Text="Ajouter une expérience" />
                    <TextBlock Margin="0,6,0,0"
                               Style="{StaticResource Text.Body.Secondary}"
                               Text="Collez l'adresse officielle de la page Roblox ou son identifiant de lieu." />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Style="{StaticResource Text.Caption}" Text="Nom de l'expérience" />
                            <TextBox Margin="0,4,0,0"
                                     AutomationProperties.Name="Nom de l'expérience"
                                     MaxLength="60"
                                     Style="{StaticResource Input.Text}"
                                     Text="{Binding NewExperienceName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Style="{StaticResource Text.Caption}" Text="Lien ou identifiant de lieu" />
                            <TextBox Margin="0,4,0,0"
                                     AutomationProperties.Name="Lien ou identifiant de lieu"
                                     MaxLength="200"
                                     Style="{StaticResource Input.Text}"
                                     Text="{Binding NewExperienceLink, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <Button Grid.Column="2"
                                Margin="0,18,0,0"
                                VerticalAlignment="Top"
                                AutomationProperties.Name="Ajouter à la bibliothèque"
                                Command="{Binding AddExperienceCommand}"
                                Content="Ajouter à la bibliothèque"
                                Style="{StaticResource Button.Primary}" />
                    </Grid>

                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource Text.Caption}"
                               Text="Exemple : https://www.roblox.com/games/920587237/Adopt-Me ou 920587237. Seules les adresses roblox.com sont acceptées." />
                </StackPanel>
            </Border>

            <!-- 2. Expériences -->
            <Border Margin="0,14,0,0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Section}" Text="Expériences" />

                    <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Experiences}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Style="{StaticResource Card.Inset}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Text.Strong}" Text="{Binding Name}" />
                                            <TextBlock Margin="0,3,0,0" Style="{StaticResource Text.Caption}" Text="{Binding Details}" />
                                            <TextBlock Margin="0,2,0,0" Style="{StaticResource Text.Caption}" Text="{Binding OpenedText}" />
                                            <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Mono}" Text="{Binding Url}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    Margin="16,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal">
                                            <Button AutomationProperties.Name="Ouvrir sur Roblox"
                                                    Command="{Binding DataContext.OpenExperienceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource Button.Secondary}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontSize="12" Style="{StaticResource Text.Icon}" Text="&#xE8A7;" />
                                                    <TextBlock Margin="8,0,0,0" Text="Ouvrir sur Roblox" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>

                                            <Button Margin="8,0,0,0"
                                                    AutomationProperties.Name="Retirer de la bibliothèque"
                                                    Command="{Binding DataContext.RemoveExperienceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="Retirer"
                                                    Style="{StaticResource Button.Subtle}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="0,8,0,0">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasExperiences}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock VerticalAlignment="Top"
                                   FontSize="16"
                                   Foreground="{DynamicResource Brush.Text.Tertiary}"
                                   Style="{StaticResource Text.Icon}"
                                   Text="&#xE8F1;" />
                        <TextBlock Grid.Column="1"
                                   Margin="10,0,0,0"
                                   Style="{StaticResource Text.Body.Secondary}"
                                   Text="Aucune expérience enregistrée. Ajoutez un lien officiel pour la retrouver ici ; LinkLauncher ne télécharge rien et ne rejoint aucune partie à votre place." />
                    </Grid>

                    <Border Margin="0,12,0,0" Style="{StaticResource Card.Inset}">
                        <TextBlock Style="{StaticResource Text.Mono}" Text="{Binding LibraryFilePath}" />
                    </Border>

                    <TextBlock Margin="0,10,0,0"
                               Style="{StaticResource Text.Caption}"
                               Text="« Ouvrir sur Roblox » ouvre la page officielle dans votre navigateur : c'est Roblox qui gère votre connexion et le lancement de la partie. LinkLauncher ne lit ni ne stocke aucun identifiant." />
                </StackPanel>
            </Border>

            <!-- 3. Profils de lancement -->
            <Border Margin="0,14,0,0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Section}" Text="Profils de lancement" />
                    <TextBlock Margin="0,6,0,0"
                               Style="{StaticResource Text.Body.Secondary}"
                               Text="Un profil ne contient qu'une langue transmise au client Roblox : aucun identifiant, aucun cookie et aucun jeton n'y est enregistré." />

                    <ListBox Margin="0,12,0,0"
                             AutomationProperties.Name="Profils de lancement"
                             ItemsSource="{Binding Profiles}"
                             SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                             Style="{StaticResource OptionList}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.Strong}" Text="{Binding Label}" />
                                    <TextBlock Margin="0,2,0,0" Style="{StaticResource Text.Caption}" Text="{Binding Description}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Style="{StaticResource Text.Caption}" Text="Nom du profil" />
                            <TextBox Margin="0,4,0,0"
                                     AutomationProperties.Name="Nom du profil"
                                     MaxLength="60"
                                     Style="{StaticResource Input.Text}"
                                     Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Style="{StaticResource Text.Caption}" Text="Langue (facultatif)" />
                            <TextBox Margin="0,4,0,0"
                                     AutomationProperties.Name="Langue du profil"
                                     MaxLength="16"
                                     Style="{StaticResource Input.Text}"
                                     Text="{Binding NewProfileLocale, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <Button Grid.Column="2"
                                Margin="0,18,0,0"
                                VerticalAlignment="Top"
                                AutomationProperties.Name="Ajouter le profil"
                                Command="{Binding AddProfileCommand}"
                                Content="Ajouter"
                                Style="{StaticResource Button.Secondary}" />

                        <Button Grid.Column="3"
                                Margin="8,18,0,0"
                                VerticalAlignment="Top"
                                AutomationProperties.Name="Supprimer le profil sélectionné"
                                Command="{Binding RemoveProfileCommand}"
                                Content="Supprimer"
                                Style="{StaticResource Button.Subtle}"
                                ToolTip="Supprime le profil sélectionné ; le dernier profil ne peut pas être supprimé." />
                    </Grid>

                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource Text.Caption}"
                               Text="Langue acceptée : fr_FR, en-US, pt-BR… Laissez vide pour suivre la langue de Windows." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>

</UserControl>
