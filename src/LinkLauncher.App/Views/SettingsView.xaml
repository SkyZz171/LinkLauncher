<UserControl x:Class="LinkLauncher.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:LinkLauncher.App.Views"
             Background="Transparent"
             Focusable="False">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False">
        <StackPanel Margin="{StaticResource Padding.Page}" MaxWidth="920" HorizontalAlignment="Stretch">

            <TextBlock Style="{StaticResource Text.PageTitle}" Text="Paramètres" />
            <TextBlock Margin="0,4,0,20"
                       Style="{StaticResource Text.Body.Secondary}"
                       Text="Apparence, notifications, présence Discord et diagnostic de LinkLauncher." />

            <!-- Erreur -->
            <Border Margin="0,0,0,14"
                    Padding="14,10"
                    Background="{DynamicResource Brush.Danger.Subtle}"
                    BorderBrush="{DynamicResource Brush.Danger}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Control}"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="13" Foreground="{DynamicResource Brush.Danger}" Style="{StaticResource Text.Icon}" Text="&#xEA39;" />
                    <TextBlock Margin="10,0,0,0"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               Style="{StaticResource Text.Body.Secondary}"
                               Text="{Binding ErrorMessage}" />
                </StackPanel>
            </Border>

            <!-- Confirmation -->
            <Border Margin="0,0,0,14"
                    Padding="14,10"
                    Background="{DynamicResource Brush.Success.Subtle}"
                    BorderBrush="{DynamicResource Brush.Success}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Control}"
                    Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="13" Foreground="{DynamicResource Brush.Success}" Style="{StaticResource Text.Icon}" Text="&#xE73E;" />
                    <TextBlock Margin="10,0,0,0"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               Style="{StaticResource Text.Body.Secondary}"
                               Text="{Binding StatusMessage}" />
                </StackPanel>
            </Border>

            <!-- Apparence -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="16" Foreground="{DynamicResource Brush.Accent}" Style="{StaticResource Text.Icon}" Text="&#xE790;" />
                        <TextBlock Margin="10,0,0,0" Style="{StaticResource Text.Section}" Text="Apparence" />
                    </StackPanel>

                    <TextBlock Margin="0,18,0,0" Style="{StaticResource Text.Strong}" Text="Thème" />

                    <ListBox Margin="0,8,0,0"
                             AutomationProperties.Name="Thème"
                             ItemsSource="{Binding ThemeOptions}"
                             SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                             Style="{StaticResource OptionList}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.Strong}" Text="{Binding Label}" />
                                    <TextBlock Margin="0,2,0,0" Style="{StaticResource Text.Caption}" Text="{Binding Description}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Margin="0,14,0,0" Style="{StaticResource Text.Strong}" Text="Couleur d'accentuation" />

                    <ListBox Margin="0,10,0,0"
                             AutomationProperties.Name="Couleur d'accentuation"
                             ItemsSource="{Binding AccentOptions}"
                             SelectedItem="{Binding SelectedAccent, Mode=TwoWay}"
                             Style="{StaticResource SwatchList}" />
                </StackPanel>
            </Border>

            <!-- Notifications -->
            <Border Margin="0,14,0,0" Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="16" Foreground="{DynamicResource Brush.Accent}" Style="{StaticResource Text.Icon}" Text="&#xE7E7;" />
                        <TextBlock Margin="10,0,0,0" Style="{StaticResource Text.Section}" Text="Notifications" />
                    </StackPanel>

                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource Text.Body.Secondary}"
                               Text="Une notification discrète signale le démarrage et la fermeture du client Roblox, y compris lancé depuis le navigateur." />

                    <CheckBox Margin="0,14,0,0"
                              AutomationProperties.Name="Notifications du client Roblox"
                              Content="Me prévenir quand le client Roblox démarre ou s'arrête"
                              Foreground="{DynamicResource Brush.Text.Primary}"
                              IsChecked="{Binding EnableNotifications, Mode=TwoWay}" />

                    <TextBlock Margin="0,10,0,0"
                               Style="{StaticResource Text.Caption}"
                               Text="Les notifications restent locales : aucun envoi vers Internet n'est effectué." />
                </StackPanel>
            </Border>

            <!-- Présence Discord -->
            <Border Margin="0,14,0,0" Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="16" Foreground="{DynamicResource Brush.Accent}" Style="{StaticResource Text.Icon}" Text="&#xE8D6;" />
                        <TextBlock Margin="10,0,0,0" Style="{StaticResource Text.Section}" Text="Présence Discord" />
                    </StackPanel>

                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource Text.Body.Secondary}"
                               Text="Affiche sur votre profil Discord que LinkLauncher est ouvert, et si le client Roblox tourne. La présence passe par le client Discord installé sur ce PC." />

                    <CheckBox Margin="0,14,0,0"
                              AutomationProperties.Name="Présence Discord"
                              Content="Publier mon activité sur Discord"
                              Foreground="{DynamicResource Brush.Text.Primary}"
                              IsChecked="{Binding EnableDiscordPresence, Mode=TwoWay}" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Style="{StaticResource Text.Caption}" Text="Identifiant d'application Discord" />
                            <TextBox Margin="0,4,0,0"
                                     AutomationProperties.Name="Identifiant d'application Discord"
                                     MaxLength="20"
                                     Style="{StaticResource Input.Text}"
                                     Text="{Binding DiscordApplicationId, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Margin="0,18,0,0"
                                VerticalAlignment="Top"
                                AutomationProperties.Name="Enregistrer l'identifiant Discord"
                                Command="{Binding SaveDiscordApplicationIdCommand}"
                                Content="Enregistrer"
                                Style="{StaticResource Button.Secondary}" />
                    </Grid>

                    <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Strong}" Text="{Binding DiscordStatusText}" />

                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource Text.Caption}"
                               Text="L'identifiant d'application est public et se crée sur discord.com/developers/applications. Aucun jeton, aucun secret et aucune donnée de compte Roblox ne sont demandés ni stockés." />
                </StackPanel>
            </Border>

            <!-- Diagnostic -->
            <Border Margin="0,14,0,0" Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="16" Foreground="{DynamicResource Brush.Accent}" Style="{StaticResource Text.Icon}" Text="&#xE9D9;" />
                        <TextBlock Margin="10,0,0,0" Style="{StaticResource Text.Section}" Text="Diagnostic" />
                    </StackPanel>

                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource Text.Body.Secondary}"
                               Text="État réel de l'application, de la machine et de l'installation Roblox. Le rapport ne contient aucun identifiant." />

                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                        <Button AutomationProperties.Name="Collecter le diagnostic"
                                Command="{Binding RefreshDiagnosticsCommand}"
                                Content="Collecter"
                                Style="{StaticResource Button.Secondary}" />
                        <Button Margin="8,0,0,0"
                                AutomationProperties.Name="Copier le rapport"
                                Command="{Binding CopyDiagnosticsCommand}"
                                Content="Copier le rapport"
                                Style="{StaticResource Button.Subtle}" />
                        <Button Margin="8,0,0,0"
                                AutomationProperties.Name="Ouvrir le dossier des journaux"
                                Command="{Binding OpenLogsFolderCommand}"
                                Content="Ouvrir les journaux"
                                Style="{StaticResource Button.Subtle}" />
                    </StackPanel>

                    <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding Diagnostics}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Label}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Text.Mono}" Text="{Binding Value}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Caption}" Text="{Binding DiagnosticsSummary}" />

                    <Border Margin="0,12,0,0" Style="{StaticResource Card.Inset}">
                        <TextBlock Style="{StaticResource Text.Mono}" Text="{Binding LogsDirectory}" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- Mises à jour -->
            <views:UpdateView Margin="0,14,0,0" DataContext="{Binding Updates}" />

            <!-- Configuration -->
            <Border Margin="0,14,0,0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Section}" Text="Configuration" />
                    <TextBlock Margin="0,6,0,0"
                               Style="{StaticResource Text.Body.Secondary}"
                               Text="Les préférences sont écrites dans un fichier JSON, avec conservation de la version précédente." />

                    <Border Margin="0,12,0,0" Style="{StaticResource Card.Inset}">
                        <TextBlock Style="{StaticResource Text.Mono}" Text="{Binding SettingsFilePath}" />
                    </Border>

                    <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Caption}">
                        <Run Text="LinkLauncher " />
                        <Run Text="{Binding AppVersion, Mode=OneWay}" />
                        <Run Text=" — phase 5" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>

</UserControl>
