<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Typographie -->
    <FontFamily x:Key="Font.Primary">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Icon">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Courier New</FontFamily>

    <sys:Double x:Key="FontSize.Display">26</sys:Double>
    <sys:Double x:Key="FontSize.PageTitle">23</sys:Double>
    <sys:Double x:Key="FontSize.Headline">19</sys:Double>
    <sys:Double x:Key="FontSize.Section">15</sys:Double>
    <sys:Double x:Key="FontSize.Value">19</sys:Double>
    <sys:Double x:Key="FontSize.Body">13</sys:Double>
    <sys:Double x:Key="FontSize.Caption">11.5</sys:Double>
    <sys:Double x:Key="FontSize.Icon">15</sys:Double>

    <!-- Rayons -->
    <CornerRadius x:Key="Radius.Card">14</CornerRadius>
    <CornerRadius x:Key="Radius.Control">9</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">99</CornerRadius>

    <!-- Espacements -->
    <Thickness x:Key="Padding.Page">32,26,32,32</Thickness>
    <Thickness x:Key="Padding.Card">22</Thickness>
    <Thickness x:Key="Padding.Control">15,0</Thickness>
    <Thickness x:Key="Spacing.CardGap">0,0,12,12</Thickness>

    <!-- Dimensions -->
    <sys:Double x:Key="Size.Sidebar">248</sys:Double>
    <sys:Double x:Key="Size.SidebarCompact">76</sys:Double>
    <sys:Double x:Key="Size.TitleBar">44</sys:Double>
    <sys:Double x:Key="Size.WindowButton">46</sys:Double>
    <sys:Double x:Key="Size.Window.MinWidth">840</sys:Double>
    <sys:Double x:Key="Size.Window.MinHeight">580</sys:Double>

    <!-- Glyphes (Segoe Fluent Icons / Segoe MDL2 Assets) -->
    <sys:String x:Key="Glyph.Home">&#xE80F;</sys:String>
    <sys:String x:Key="Glyph.Settings">&#xE713;</sys:String>
    <sys:String x:Key="Glyph.Play">&#xE768;</sys:String>
    <sys:String x:Key="Glyph.Folder">&#xE838;</sys:String>
    <sys:String x:Key="Glyph.Refresh">&#xE72C;</sys:String>
    <sys:String x:Key="Glyph.Palette">&#xE790;</sys:String>
    <sys:String x:Key="Glyph.Theme">&#xE793;</sys:String>
    <sys:String x:Key="Glyph.Warning">&#xE7BA;</sys:String>
    <sys:String x:Key="Glyph.Error">&#xEA39;</sys:String>
    <sys:String x:Key="Glyph.Minimize">&#xE921;</sys:String>
    <sys:String x:Key="Glyph.Maximize">&#xE922;</sys:String>
    <sys:String x:Key="Glyph.Restore">&#xE923;</sys:String>
    <sys:String x:Key="Glyph.Close">&#xE8BB;</sys:String>

</ResourceDictionary>
