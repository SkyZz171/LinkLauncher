<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Brush.Canvas" Color="#F2F4FA" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="#FAFBFE" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Surface.Alt" Color="#F5F7FC" />
    <SolidColorBrush x:Key="Brush.Surface.Hover" Color="#EDF1F9" />
    <SolidColorBrush x:Key="Brush.Surface.Pressed" Color="#E4EAF5" />

    <LinearGradientBrush x:Key="Brush.Hero" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FFFFFF" />
        <GradientStop Offset="1" Color="#F4F6FD" />
    </LinearGradientBrush>

    <!-- Traits -->
    <SolidColorBrush x:Key="Brush.Stroke" Color="#E2E8F2" />
    <SolidColorBrush x:Key="Brush.Stroke.Strong" Color="#C7D1E1" />

    <!-- Texte -->
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#0F1622" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#49576B" />
    <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="#6E7C91" />
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="#FFFFFF" />

    <!-- Accentuation : remplacée à l'exécution par le service de thème -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#6B49F5" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="#7C5CFF" />
    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="#5A3BE0" />
    <SolidColorBrush x:Key="Brush.Accent.Subtle" Color="#EFEBFF" />
    <SolidColorBrush x:Key="Brush.Accent.Border" Color="#D5CBFF" />

    <!-- États -->
    <SolidColorBrush x:Key="Brush.Success" Color="#0F7A52" />
    <SolidColorBrush x:Key="Brush.Success.Subtle" Color="#E3F6EE" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#8A5A00" />
    <SolidColorBrush x:Key="Brush.Warning.Subtle" Color="#FDF3E1" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#B62F45" />
    <SolidColorBrush x:Key="Brush.Danger.Subtle" Color="#FCE8EC" />

    <!-- Chrome de fenêtre -->
    <SolidColorBrush x:Key="Brush.WindowButton.Hover" Color="#14000000" />
    <SolidColorBrush x:Key="Brush.WindowButton.Pressed" Color="#0A000000" />
    <SolidColorBrush x:Key="Brush.Close.Hover" Color="#E81123" />

    <SolidColorBrush x:Key="Brush.ToolTip" Color="#FFFFFF" />

</ResourceDictionary>
