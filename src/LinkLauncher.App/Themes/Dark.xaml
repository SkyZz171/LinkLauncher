<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Brush.Canvas" Color="#0E1015" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="#12151B" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#171A21" />
    <SolidColorBrush x:Key="Brush.Surface.Alt" Color="#1C2029" />
    <SolidColorBrush x:Key="Brush.Surface.Hover" Color="#232936" />
    <SolidColorBrush x:Key="Brush.Surface.Pressed" Color="#2A3140" />

    <LinearGradientBrush x:Key="Brush.Hero" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#1B2030" />
        <GradientStop Offset="1" Color="#15181F" />
    </LinearGradientBrush>

    <!-- Traits -->
    <SolidColorBrush x:Key="Brush.Stroke" Color="#242A35" />
    <SolidColorBrush x:Key="Brush.Stroke.Strong" Color="#333B4A" />

    <!-- Texte -->
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#F1F4FA" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#A5AEBF" />
    <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="#7A8597" />
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="#FFFFFF" />

    <!-- Accentuation : remplacée à l'exécution par le service de thème -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#7C5CFF" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="#8E72FF" />
    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="#6A4AEF" />
    <SolidColorBrush x:Key="Brush.Accent.Subtle" Color="#2D2952" />
    <SolidColorBrush x:Key="Brush.Accent.Border" Color="#443885" />

    <!-- États -->
    <SolidColorBrush x:Key="Brush.Success" Color="#3FCF8E" />
    <SolidColorBrush x:Key="Brush.Success.Subtle" Color="#17352A" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#F2B14B" />
    <SolidColorBrush x:Key="Brush.Warning.Subtle" Color="#362B17" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#F0637A" />
    <SolidColorBrush x:Key="Brush.Danger.Subtle" Color="#371E24" />

    <!-- Chrome de fenêtre -->
    <SolidColorBrush x:Key="Brush.WindowButton.Hover" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Brush.WindowButton.Pressed" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="Brush.Close.Hover" Color="#E81123" />

    <SolidColorBrush x:Key="Brush.ToolTip" Color="#1F242E" />

</ResourceDictionary>
