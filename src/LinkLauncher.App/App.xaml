<Application x:Class="LinkLauncher.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:LinkLauncher.App.Converters"
             xmlns:activity="clr-namespace:LinkLauncher.Features.Activity;assembly=LinkLauncher.Features"
             xmlns:dashboard="clr-namespace:LinkLauncher.Features.Dashboard;assembly=LinkLauncher.Features"
             xmlns:library="clr-namespace:LinkLauncher.Features.Library;assembly=LinkLauncher.Features"
             xmlns:settings="clr-namespace:LinkLauncher.Features.Settings;assembly=LinkLauncher.Features"
             xmlns:views="clr-namespace:LinkLauncher.App.Views"
             ShutdownMode="OnMainWindowClose">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Tokens.xaml" />
                <ResourceDictionary Source="Themes/Dark.xaml" />
                <ResourceDictionary Source="Themes/Controls/Typography.xaml" />
                <ResourceDictionary Source="Themes/Controls/Buttons.xaml" />
                <ResourceDictionary Source="Themes/Controls/Cards.xaml" />
                <ResourceDictionary Source="Themes/Controls/Inputs.xaml" />
                <ResourceDictionary Source="Themes/Controls/Lists.xaml" />
                <ResourceDictionary Source="Themes/Controls/ScrollBars.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:NullToVisibilityConverter x:Key="NullToVisibility" />
            <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

            <DataTemplate DataType="{x:Type dashboard:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type library:LibraryViewModel}">
                <views:LibraryView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type activity:ActivityViewModel}">
                <views:ActivityView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type settings:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>

</Application>
